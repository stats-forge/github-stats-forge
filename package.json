{
  "name": "@stats-forge/root",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "cli": "pnpm run build:packages && node packages/cli/build/index.js",
    "docs": "pnpm run build:packages && pnpm --filter ./apps/docs run dev",
    "server:standalone": "pnpm --filter ./apps/server run dev",
    "server:hosted": "SITE_BASE=/ SITE_SERVER=true pnpm run docs:build && SITE_DIR=../docs/build pnpm run server:standalone",
    "docs:sync": "pnpm --filter ./apps/docs exec astro sync",
    "docs:build": "pnpm run build:packages && pnpm --filter ./apps/docs run build",
    "docs:cards": "pnpm run build:packages && pnpm --filter ./apps/docs run generate-cards",
    "docs:cards:check": "pnpm run build:packages && pnpm --filter ./apps/docs run check-cards",
    "docs:e2e": "pnpm run docs:build && pnpm --filter ./apps/docs run test:e2e",
    "test": "vitest --run",
    "test:coverage": "vitest --run --config vitest.config.coverage.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "lint:fix": "oxlint --fix",
    "lint:knip": "knip",
    "lint:publish": "pnpm -r --filter \"./packages/*\" run lint:publish",
    "typecheck": "pnpm run build:packages && pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run typecheck && tsc -p tsconfig.scripts.json",
    "check-all": "node scripts/check-all.ts",
    "test:live": "pnpm --filter ./apps/docs run test:live",
    "release": "pnpm run build:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@marcalexiei/oxfmt-config": "2.0.1",
    "@marcalexiei/oxlint-config": "1.9.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "catalog:default",
    "knip": "6.43.0",
    "lefthook": "2.2.1",
    "oxfmt": "catalog:default",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "catalog:default"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
