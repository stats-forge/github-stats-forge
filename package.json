{
  "name": "@stats-forge/root",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build:packages": "turbo run build --filter=./packages/*",
    "examples": "pnpm run build:packages && node examples/generate.ts",
    "test": "vitest",
    "test:coverage": "vitest --config vitest.config.coverage.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "lint:fix": "oxlint --fix",
    "lint:knip": "knip",
    "lint:deps": "node scripts/assert-deduped.ts",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json",
    "release": "pnpm run build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@marcalexiei/oxfmt-config": "1.3.0",
    "@marcalexiei/oxlint-config": "1.5.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "catalog:default",
    "knip": "6.33.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "catalog:default"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
