{
  "$schema": "./node_modules/knip/schema.json",
  "vitest": {
    "entry": ["tests/**/*.{test,test-d,bench}.{js,ts}"]
  },
  "workspaces": {
    "packages/core": {
      // generated by scripts/generate-graphql-types.js
      "ignore": ["src/graphql/generated/**"]
    },
    "apps/server": {
      // the Dockerfile's HEALTHCHECK runs it, so nothing in the repository imports it
      "entry": ["src/healthcheck.ts"]
    },
    "apps/docs": {
      // playwright.config.ts names it in a `command`, so nothing imports it
      "entry": ["e2e/serve.ts"],
      // named in `vite.optimizeDeps.include`, not imported — see astro.config.ts
      "ignoreDependencies": ["zod"]
    }
  }
}
