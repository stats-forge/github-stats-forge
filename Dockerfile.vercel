# syntax=docker/dockerfile:1

# Vercel detects this file, builds it, pushes the result to Vercel Container
# Registry and serves it from a Vercel Function:
# https://vercel.com/docs/functions/container-images
#
# A Vercel Function only runs images stored in that registry, so the image CI
# publishes to GHCR gets there by being pulled in here: this build re-tags an
# already-built image instead of building the app a second time. Everything the
# image needs — `CMD`, `PORT`, `FRONTEND_DIR` — comes with it.
#
# The GHCR package has to be public, or Vercel's builder cannot pull it.
# Point `IMAGE` at a release tag to pin a deployment to one build.
ARG IMAGE=ghcr.io/stats-forge/github-stats-forge:main
FROM ${IMAGE}
