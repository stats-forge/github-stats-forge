{
  "name": "@stats-forge/github-stats-forge-catalog",
  "version": "0.1.0",
  "description": "What each GitHub Stats Forge card accepts: every option's name, label, kind and accepted values",
  "keywords": [
    "card-generator",
    "cards",
    "github-stats",
    "github-stats-forge",
    "stats-forge"
  ],
  "homepage": "https://github.com/stats-forge/github-stats-forge",
  "bugs": {
    "url": "https://github.com/stats-forge/github-stats-forge/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Marco Pasqualetti",
    "url": "https://github.com/marcalexiei"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stats-forge/github-stats-forge.git",
    "directory": "packages/catalog"
  },
  "files": [
    "build",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@stats/source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "lint:publish": "attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm && publint --strict",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@stats-forge/github-stats-forge-core": "workspace:^"
  },
  "devDependencies": {
    "vitest": "catalog:default"
  },
  "engines": {
    "node": "^24 || >=26"
  }
}
