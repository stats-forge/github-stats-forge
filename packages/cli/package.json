{
  "name": "@stats-forge/github-stats-forge-cli",
  "version": "0.4.0",
  "description": "Render a GitHub stats card to a local SVG file, one prompt at a time",
  "keywords": [
    "cli",
    "github-stats",
    "github-stats-forge",
    "stats-forge"
  ],
  "homepage": "https://github.com/stats-forge/github-stats-forge",
  "bugs": {
    "url": "https://github.com/stats-forge/github-stats-forge/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Marco Pasqualetti",
    "url": "https://github.com/marcalexiei"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stats-forge/github-stats-forge.git",
    "directory": "packages/cli"
  },
  "bin": {
    "github-stats-forge": "./bin.js"
  },
  "files": [
    "bin.js",
    "build",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@stats/source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./cards": {
      "@stats/source": "./src/cards.ts",
      "default": "./build/cards.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "lint:publish": "attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm && publint --strict",
    "dev": "node --conditions=@stats/source src/index.ts",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@inquirer/checkbox": "5.2.3",
    "@inquirer/confirm": "6.3.0",
    "@inquirer/input": "5.1.4",
    "@inquirer/password": "5.2.0",
    "@inquirer/select": "5.2.3",
    "@stats-forge/github-stats-forge-core": "workspace:^"
  },
  "devDependencies": {
    "vitest": "catalog:default"
  },
  "engines": {
    "node": "^24 || >=26"
  }
}
