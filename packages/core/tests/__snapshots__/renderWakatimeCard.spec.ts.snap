exports[`Test Render WakaTime Card > should render correctly 1`] = `
"<svg width="500" height="150" viewBox="0 0 500 150" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="title-id desc-id">
  <title id="title-id">WakaTime Stats (last 7 days)</title>
  <desc id="desc-id">22 hrs 40 mins, 4 hrs 32 mins a day. Other: 19 mins, TypeScript: 1 min</desc>
  <style>
    .header {
      font: 600 18px 'Segoe UI', Ubuntu, "Helvetica Neue", Sans-Serif;
      fill: url(#heat);
      animation: fadeInAnimation 0.8s ease-in-out backwards;
    }
    /* The icon reads against the title rather than with it, so it keeps its own color. */
    .title-icon {
      fill: #e2470f;
      animation: fadeInAnimation 0.8s ease-in-out backwards;
    }
    .title-accent {
      transform-box: fill-box;
      transform-origin: left center;
      animation: trailAnimation 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s backwards;
    }
    @supports(-moz-appearance: auto) {
      /* Selector detects Firefox */
      .header {
        font-size: 15.5px;
      }
    }
    .stat {
      font: 400 14px 'Segoe UI', Ubuntu, "Helvetica Neue", Sans-Serif;
      fill: #2a1b14;
    }
    @supports(-moz-appearance: auto) {
      /* Selector detects Firefox */
      .stat {
        font-size: 12px;
      }
    }
    .stagger {
      animation: fadeInAnimation 0.3s ease-in-out backwards;
    }
    .not_bold {
      font-weight: 400;
    }
    .bold {
      font-weight: 600;
    }
    @keyframes slideInAnimation {
      from {
        width: 0;
      }
      to {
        width: calc(100%-100px);
      }
    }
    @keyframes growWidthAnimation {
      from {
        width: 0;
      }
      to {
        width: 100%;
      }
    }
    .lang-name {
      font: 400 11px 'Segoe UI', Ubuntu, "Helvetica Neue", Sans-Serif;
      fill: #2a1b14;
    }
    #rect-mask rect {
      animation: slideInAnimation 1s ease-in-out backwards;
    }
    .lang-progress {
      animation: growWidthAnimation 0.6s ease-in-out backwards;
      fill: url(#heat);
    }
    .progress-background {
      fill: #ddd;
    }
    .headline-total {
      font: 600 22px 'Segoe UI', Ubuntu, "Helvetica Neue", Sans-Serif;
      fill: url(#heat);
    }
    .headline-average {
      font: 400 12px 'Segoe UI', Ubuntu, "Helvetica Neue", Sans-Serif;
      fill: #2a1b14;
      opacity: 0.75;
    }
    @media (prefers-color-scheme: dark) {
      .heat-0 {
        stop-color: #ffd166;
      }
      .heat-1 {
        stop-color: #ff7a1a;
      }
      .heat-2 {
        stop-color: #ff2e63;
      }
      .glow-core {
        stop-color: #ff7a1a;
        stop-opacity: 0.42;
      }
      .glow-edge {
        stop-color: #ff2e63;
        stop-opacity: 0.147;
      }
      .band-0 {
        stop-color: #ffd166;
        stop-opacity: 0.16;
      }
      .band-1 {
        stop-color: #ff7a1a;
        stop-opacity: 0.16;
      }
      .band-2 {
        stop-color: #ff2e63;
        stop-opacity: 0.112;
      }
      .title-icon {
        fill: #ff7a1a;
      }
      .card-bg {
        fill: #16100d;
        stroke: #ff7a1a4d;
      }
      .stat {
        fill: #f7ede6;
      }
      .lang-name {
        fill: #f7ede6;
      }
      .progress-background {
        fill: #ffffff33;
      }
      .headline-average {
        fill: #f7ede6;
      }
    }
    /* Animations */
    @keyframes scaleInAnimation {
      from {
        transform: translate(-5px, 5px) scale(0);
      }
      to {
        transform: translate(-5px, 5px) scale(1);
      }
    }
    @keyframes fadeInAnimation {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    @keyframes trailAnimation {
      from {
        transform: scaleX(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0s !important;
        animation-delay: 0s !important;
      }
    }
  </style>
  <defs>
    <linearGradient id="heat" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" class="heat-0" stop-color="#dc7600" />
      <stop offset="0.55" class="heat-1" stop-color="#e2470f" />
      <stop offset="1" class="heat-2" stop-color="#c8174f" />
    </linearGradient>
    <linearGradient id="heat-trail" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" class="heat-0" stop-color="#dc7600" />
      <stop offset="0.3" class="heat-1" stop-color="#e2470f" />
      <stop offset="0.7" class="heat-2" stop-color="#c8174f" stop-opacity="0.5" />
      <stop offset="1" class="heat-2" stop-color="#c8174f" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="heat-band" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" class="band-0" stop-color="#dc7600" stop-opacity="0.1" />
      <stop offset="0.55" class="band-1" stop-color="#e2470f" stop-opacity="0.1" />
      <stop offset="1" class="band-2" stop-color="#c8174f" stop-opacity="0.07" />
    </linearGradient>
    <radialGradient id="heat-glow" cx="0.95" cy="1.05" r="0.8">
      <stop offset="0" class="glow-core" stop-color="#e2470f" stop-opacity="0.17" />
      <stop offset="0.45" class="glow-edge" stop-color="#c8174f" stop-opacity="0.06" />
      <stop offset="1" class="heat-2" stop-color="#c8174f" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect data-testid="card-bg" class="card-bg" x="0.5" y="0.5" rx="14" height="99%" width="499" stroke="#e2470f4d" fill="#fffaf6" stroke-opacity="1" />
  <rect data-testid="card-glow" x="0.5" y="0.5" rx="14" height="99%" width="499" fill="url(#heat-glow)" />
  <path data-testid="title-band" d="M0.5 14.5a14 14 0 0 1 14 -14h471a14 14 0 0 1 14 14v26.5h-499z" fill="url(#heat-band)" />
  <g data-testid="card-title" transform="translate(18, 25)">
    <g>
      <svg class="title-icon" x="0" y="-13" viewBox="0 0 16 16" version="1.1" width="16" height="16">
        <path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm7-3.25v2.992l2.028.812a.75.75 0 0 1-.557 1.392l-2.5-1A.75.75 0 0 1 7 8.25v-3.5a.75.75 0 0 1 1.5 0Z" />
      </svg>
    </g>
    <g transform="translate(25, 0)">
      <text x="0" y="0" class="header" data-testid="header">WakaTime Stats (last 7 days)</text>
    </g>
    <rect data-testid="title-accent" class="title-accent" x="0" y="8" width="296.3" height="2" rx="1" fill="url(#heat-trail)" />
  </g>
  <g data-testid="main-card-body" transform="translate(0, 50)">
    <svg x="0" y="0" width="100%">
      <g data-testid="headline">
        <text data-testid="total" class="headline-total" x="18" y="17">22 hrs 40 mins</text>
        <text data-testid="daily-average" class="headline-average" x="183" y="17">4 hrs 32 mins a day</text>
      </g>
      <g transform="translate(0, 36)">
        <g>
          <g class="stagger" style="animation-delay: 450ms" transform="translate(18, 0)">
            <text class="stat bold" y="12.5" data-testid="Other">Other:</text>
            <text class="stat" x="369" y="12.5">19 mins</text>
            <svg width="239" x="110" y="4">
              <rect data-testid="progress-background" class="progress-background" rx="5" ry="5" x="0" y="0" width="239" height="8" />
              <svg data-testid="lang-progress" width="89.38%">
                <rect width="100%" height="8" rx="5" ry="5" x="0" y="0" class="lang-progress" style="animation-delay: 750ms;" />
              </svg>
            </svg>
          </g>
        </g>
        <g transform="translate(0, 25)">
          <g class="stagger" style="animation-delay: 600ms" transform="translate(18, 0)">
            <text class="stat bold" y="12.5" data-testid="TypeScript">TypeScript:</text>
            <text class="stat" x="369" y="12.5">1 min</text>
            <svg width="239" x="110" y="4">
              <rect data-testid="progress-background" class="progress-background" rx="5" ry="5" x="0" y="0" width="239" height="8" />
              <svg data-testid="lang-progress" width="6.25%">
                <rect width="100%" height="8" rx="5" ry="5" x="0" y="0" class="lang-progress" style="animation-delay: 900ms;" />
              </svg>
            </svg>
          </g>
        </g>
      </g>
    </svg>
  </g>
</svg>
"
`;

