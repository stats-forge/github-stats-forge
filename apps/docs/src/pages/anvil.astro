---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

import { CARDS } from '../anvil/cards.ts';
import NewTabLink from '../components/NewTabLink.astro';
import { BASE, SERVED_BY_INSTANCE } from '../constants.ts';

/*
 * Imported here rather than listed in `customCss`, so they serve this page alone, and unscoped
 * because `ui.ts` builds the controls at runtime. Web Awesome's `native.css` is left out: it
 * restyles native elements and would fight Starlight page-wide.
 */
import '@awesome.me/webawesome/dist/styles/layers.css';
import '@awesome.me/webawesome/dist/styles/themes/default.css';
import '../styles/anvil.css';

/**
 * The anvil: a form over a card's options, the card redrawn beside it, and the file the CLI reads.
 *
 * The only page here that is not markdown, and the only one that ships JavaScript. It draws in the
 * browser through core's api handlers against `src/anvil/samples.json`, so it needs no token —
 * unless the card server is serving it, which `SITE_SERVER` says and `data-source` passes on.
 *
 * The remark plugins do not run on an `.astro` page, so the links below carry the base themselves.
 *
 * A line break falling immediately before an element is dropped rather than collapsed to a space,
 * so a link wrapped onto its own line needs an explicit `{' '}` ahead of it or it runs into the
 * word before it.
 */
// The pages are not named after the card ids, and `ui.ts` sets the href where the link validator
// cannot see it — so this check is all that stands between a renamed page and a 404.
const docsPages = await getCollection('docs');
const cardPages = new Set(docsPages.map((entry) => entry.id));
for (const card of CARDS) {
  if (!cardPages.has(`docs/cards/${card.docs}`)) {
    throw new Error(`The anvil links "${card.id}" to docs/cards/${card.docs}, which is not a page`);
  }
}

/** Shown under the title as well as written into the page's meta, so the two cannot disagree. */
const DESCRIPTION =
  'Hammer a card into shape in the browser, and take away the file the CLI renders it from.';

const [first] = CARDS;
if (first === undefined) {
  throw new Error('No cards to draw');
}
---

<StarlightPage
  frontmatter={{
    title: 'The anvil',
    description: DESCRIPTION,
    template: 'splash',
    tableOfContents: false,
  }}
>
  <p class="anvil-intro">{DESCRIPTION}</p>

  <!-- `ui.ts` runs in a browser and has no environment, so the source is written onto the page. -->
  <div class="anvil" data-anvil="root" data-source={SERVED_BY_INSTANCE ? 'server' : 'sample'}>
    <div class="anvil-controls-pane">
      <!-- Every control is a Web Awesome element built by `ui.ts`; these are its mount points. -->
      <div data-anvil="source"></div>
      <div data-anvil="card"></div>

      <div class="anvil-controls" data-anvil="controls"></div>

      <div data-anvil="extra"></div>
      <p class="anvil-note">
        {'A query string, for the options this form has no control for yet. Every option is listed under '}
        <NewTabLink href={`${BASE}/docs/customization/common-options/`}>
          Customization
        </NewTabLink> 
        {' and on the '}
        <NewTabLink href={`${BASE}/docs/cards/${first.docs}/`} data-anvil="card-docs">
          selected card's page
        </NewTabLink>
        {'.'}
      </p>
    </div>

    <div class="anvil-preview-pane">
      {/* Which ground the card is shown on. Built by `ui.ts`: it follows the card's own theme. */}
      <div class="anvil-backdrop-row" data-anvil="backdrop"></div>
      {/*
        That it follows the theme is permanently true, so it is a badge with the detail on hover
        rather than a callout — the same trade the source badge below makes. The visible half is
        the part you need to not be surprised by the switch moving on its own.
      */}
      <p class="anvil-note">
        <span class="anvil-badge" id="anvil-backdrop-note" tabindex="0">
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"
            ></circle>
            <path d="M8 7.25v4.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            ></path>
            <circle cx="8" cy="4.6" r="0.9" fill="currentColor"></circle>
          </svg>
          Follows the card's theme
        </span>
      </p>
      <wa-tooltip for="anvil-backdrop-note">
        The background follows the card: the bg_color you set, or its theme. 
        When the card names neither, it stays as it is.
      </wa-tooltip>

      {/*
        `data-backdrop` is seeded here so the ground is right before the script runs, and is what
        `ui.ts` writes thereafter. The spinner is a sibling of the preview rather than inside it:
        the card is drawn into a shadow root on that element, which replaces whatever it holds.
      */}
      <div class="anvil-preview" data-anvil="frame" data-backdrop="light">
        <div class="anvil-preview-scroll">
          <div data-anvil="preview"></div>
        </div>
        {/*
          A word, not only a spinner: on a dark ground a dimmed card looks much like an undimmed
          one, and a lone ring beside the stats card's own rank ring reads as part of the card.
          The spinner is hidden from a screen reader, which has the word and the frame's
          `aria-busy` already.
        */}
        <div class="anvil-busy">
          <span class="anvil-busy-chip">
            <wa-spinner aria-hidden="true"></wa-spinner>
            Drawing…
          </span>
        </div>
      </div>
      <p class="anvil-status" data-anvil="status"></p>
      {/* The caveat is the drawing source's, so `ui.ts` writes all three. */}
      <p class="anvil-note">
        <span class="anvil-badge" id="anvil-source" tabindex="0">
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"
            ></circle>
            <path d="M8 7.25v4.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            ></path>
            <circle cx="8" cy="4.6" r="0.9" fill="currentColor"></circle>
          </svg>
          <span data-anvil="source-badge"></span>
        </span>{' '}
        <span data-anvil="source-aside"></span>
      </p>
      <wa-tooltip for="anvil-source" data-anvil="source-detail"></wa-tooltip>

      {/* Shown only on an instance: nothing else knows an address that would answer. */}
      <div class="anvil-output" data-anvil="url-panel" hidden>
        <div class="anvil-output-head">
          <span>Card URL</span>
          <span class="anvil-actions">
            <button type="button" data-anvil="copy-url">Copy URL</button>
            <button type="button" data-anvil="copy-markdown">Copy Markdown</button>
          </span>
        </div>
        <pre data-anvil="url"></pre>
        <pre data-anvil="markdown"></pre>
        <p class="anvil-note">
          This instance draws that card at that address, and the second line is what a README
          wants. Open the first to see the card on its own.
        </p>
      </div>

      <div class="anvil-output">
        <div class="anvil-output-head">
          {/* Written by `ui.ts`, with the `--config` line below it: the name follows the card. */}
          <span data-anvil="filename"></span>
          <span class="anvil-actions">
            <button type="button" data-anvil="copy">Copy</button>
            <a data-anvil="download">Download</a>
          </span>
        </div>
        <pre data-anvil="output"></pre>
        <p class="anvil-note">
          Render it with <code data-anvil="command"></code>, or pass the same options to
          {' '}<NewTabLink href={`${BASE}/docs/usage/library/`}>the library</NewTabLink>.
        </p>
      </div>
    </div>

    <wa-toast placement="bottom-end" data-anvil="toast"></wa-toast>
  </div>
</StarlightPage>

<script>
  // The Web Awesome elements in this page's own markup; the rest are built by `controls.ts`.
  import '@awesome.me/webawesome/dist/components/spinner/spinner.js';
  import '@awesome.me/webawesome/dist/components/toast/toast.js';
  import '@awesome.me/webawesome/dist/components/tooltip/tooltip.js';

  import { mount } from '../anvil/ui.ts';

  const root = document.querySelector<HTMLElement>('[data-anvil="root"]');
  if (root !== null) {
    mount(root);
  }
</script>
