---
import Default from '@astrojs/starlight/components/SiteTitle.astro';

import { SELF_HOSTED, SELF_HOSTED_DETAIL, SERVED_BY_INSTANCE } from '../constants.ts';

/**
 * The site's two halves, beside the title — and, on an instance, what is serving them.
 *
 * Starlight has no top navigation of its own, so this override adds one. The title itself is the
 * link home, which is why the landing page is not a section here.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sections: Array<{ label: string; href: string }> = [
  { label: 'Docs', href: `${base}/docs/` },
  { label: 'Anvil', href: `${base}/anvil/` },
];

const path = Astro.url.pathname;
---

<Default {...Astro.props}><slot /></Default>

{
  /*
   * The detail is CSS rather than a `wa-tooltip`, which only the anvil loads. Screen-reader-only
   * until hovered or focused, so it is in the accessibility tree either way.
   */
  SERVED_BY_INSTANCE && (
    <span class="self-hosted" tabindex="0">
      {SELF_HOSTED}
      <span class="self-hosted-detail">{SELF_HOSTED_DETAIL}</span>
    </span>
  )
}

<nav class="site-nav" aria-label="Sections">
  {
    sections.map(({ label, href }) => (
      <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
        {label}
      </a>
    ))
  }
</nav>

<style>
  /*
   * Amber, as the instance's icon is. Two shades, because the header follows the theme and each
   * clears AA on its own side. Set on the wrapper so the title, Starlight's own element beside the
   * chip, reads the same one. Its `overflow: clip` is lifted here too, or the tooltip below hangs
   * past the header's 50px and is invisible — only on a build whose title is known to fit.
   */
  :global(.title-wrapper:has(.self-hosted)) {
    --mark: #b45309;

    overflow: visible;
  }

  :global([data-theme='dark'] .title-wrapper:has(.self-hosted)) {
    --mark: #f59e0b;
  }

  :global(.title-wrapper:has(.self-hosted) .site-title) {
    color: var(--mark);
  }

  .self-hosted {
    position: relative;
    align-self: center;
    margin-inline-start: 0.6rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--mark);
    border-radius: 999px;
    color: var(--mark);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* Read by anyone, seen only on hover or focus. */
  .self-hosted-detail {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .self-hosted:hover .self-hosted-detail,
  .self-hosted:focus-visible .self-hosted-detail {
    top: calc(100% + 0.5rem);
    inset-inline-start: 0;
    width: max-content;
    max-width: min(22rem, 80vw);
    height: auto;
    padding: 0.5rem 0.75rem;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    box-shadow: var(--sl-shadow-md);
    font-weight: 400;
    line-height: 1.5;
    z-index: 1;
  }

  /* `.title-wrapper` is a flex row that stretches its items, so without this the links sit at the
     top of the header and their underline at the very bottom of it, clear of the title. */
  .site-nav {
    display: flex;
    align-self: center;
    align-items: center;
    gap: 1.5rem;
    margin-inline-start: 2rem;
    font-size: var(--sl-text-base);
    font-weight: 600;
    line-height: 1;
  }

  .site-nav a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:hover {
    color: var(--sl-color-white);
  }

  .site-nav a[aria-current='page'] {
    color: var(--sl-color-white);
    border-bottom-color: var(--sl-color-text-accent);
  }

  /*
   * A phone has no room beside the title, and hiding the links there strands the anvil: it is a
   * splash page, so it has no sidebar, and Starlight renders the menu button only for a page that
   * has one. The links take a row of their own, and the header grows by exactly that row.
   */
  @media (max-width: 50rem) {
    :global(:root) {
      --sl-nav-height: 5.25rem;
    }

    /* Starlight sizes the logo off the nav height, so pin it to what the one-row header gave it. */
    :global(.title-wrapper .site-title img) {
      height: 2rem;
    }

    /* The menu button centres itself in the header, which is now two rows; hold it on the first. */
    :global(.sl-menu-button) {
      top: calc((3.5rem - var(--sl-menu-button-size)) / 2);
    }

    /* So does the search button, 13px below the title it should sit beside. A box the height of
       the first row centres it there whatever height Starlight gives the button itself. */
    :global(.header > .sl-flex:not(.title-wrapper)) {
      align-self: start;
      align-items: center;
      height: calc(3.5rem - 2 * var(--sl-nav-pad-y));
    }

    :global(.title-wrapper) {
      flex-wrap: wrap;
      align-content: center;
    }

    .site-nav {
      flex-basis: 100%;
      margin-inline-start: 0;
      font-size: var(--sl-text-sm);
    }
  }
</style>
