{
  "name": "@stats-forge/docs",
  "private": true,
  "description": "Documentation site for github-stats-forge",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "generate-cards": "node scripts/generate-cards.ts",
    "generate-themes-page": "node --conditions=@stats/source scripts/generate-themes-page.ts",
    "check-themes-page": "node --conditions=@stats/source scripts/generate-themes-page.ts --check",
    "typecheck": "astro sync && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "astro": "7.2.10"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@marcalexiei/oxfmt-config": "1.3.0",
    "@stats-forge/github-stats-forge-core": "workspace:^",
    "@types/node": "24.13.3",
    "oxfmt": "0.65.0",
    "starlight-links-validator": "0.26.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^24 || >=26"
  }
}
